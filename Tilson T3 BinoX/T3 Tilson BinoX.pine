//@version=6
indicator("Tilson T3 By BinoX", overlay=true, max_lines_count=500, max_bars_back=500)

// ═══════════════════════════════════════════════
//  PRINCIPAL
// ═══════════════════════════════════════════════
src_input   = input.source(close, "Fonte de Preco", group="Principal")
gradientLevel = input.int(1, "Prolongamento do degrade (0 a 5)", minval=0, maxval=5, step=1, group="Principal", tooltip="0 = cores solidas por direcao, sem degrade. 1 = transicao curta; 2 a 5 = progressivamente mais prolongada. Afeta as cores da linha, sombra e halo da ponta, sem alterar a media ou os sinais.")

// ═══════════════════════════════════════════════
//  TILSON 1
// ═══════════════════════════════════════════════
showT1       = input.bool(true, "Mostrar Tilson 1", group="Tilson 1")

lengthT1     = input.int(7,  "Period",  minval=1, maxval=200, group="Tilson 1")
smoothT1     = input.int(1,  "Smooth",  minval=0, maxval=50,  group="Tilson 1")
useAdaptive1 = input.bool(false, "Adaptive ER", tooltip="Adapta o vFactor pelo Efficiency Ratio: mais responsivo em tendência e mais suave no ruído.", group="Tilson 1")
factorFix1   = input.float(0.7, "vFactor (fixo)",        minval=0.0, maxval=2.0, step=0.05, active=not useAdaptive1, group="Tilson 1")
factorAdp1   = input.float(1.0, "ER Sensitivity",        minval=0.1, maxval=5.0, step=0.1, active=useAdaptive1, group="Tilson 1", tooltip="1 = linear. Acima de 1 filtra mais a lateralização; abaixo de 1 responde mais cedo.")
vScale1      = input.float(1.0, "Escala Vertical",   minval=-100.0, maxval=100.0, step=0.05, group="Tilson 1")
hScale1      = input.float(1.0, "Escala Horizontal", minval=0.01, maxval=100.0, step=0.05, group="Tilson 1")
mainWidth1   = input.int(2, "Line", minval=1, group="Tilson 1", inline="t1Width")
shadowWidth1 = input.int(10, "Shadow", minval=1, group="Tilson 1", inline="t1Width")
t1LineUp     = input.color(#00FF00, "", group="Tilson 1", inline="t1Line")
t1LineDn     = input.color(#FF0000, "", group="Tilson 1", inline="t1Line")
t1ShadowUp   = input.color(color.new(#00FF00, 70), "", group="Tilson 1", inline="t1Line")
t1ShadowDn   = input.color(color.new(#FF0000, 70), "", group="Tilson 1", inline="t1Line")
hOffset1     = input.int(0, "Offset Horizontal (barras)", minval=-100, maxval=100, step=5, group="Tilson 1")
vOffset1     = input.int(0, "Offset Vertical Visual", minval=-100, maxval=100, step=1, group="Tilson 1")
vStrength1   = input.float(0.05, "Forca Vertical ATR", minval=0.001, maxval=1.0, step=0.01, group="Tilson 1")
showSigT1    = input.bool(false, "Mostrar Sinais (mudança de cor)", group="Tilson 1")

// ═══════════════════════════════════════════════
//  TILSON 2
// ═══════════════════════════════════════════════

showT2       = input.bool(true, "Mostrar Tilson 2", group="Tilson 2")
lengthT2     = input.int(14, "Period",  minval=1, maxval=200, group="Tilson 2")
smoothT2     = input.int(1,  "Smooth",  minval=0, maxval=50,  group="Tilson 2")
useAdaptive2 = input.bool(false, "Adaptive ER", tooltip="Adapta o vFactor pelo Efficiency Ratio: mais responsivo em tendência e mais suave no ruído.", group="Tilson 2")
factorFix2   = input.float(0.7, "vFactor (fixo)",        minval=0.0, maxval=2.0, step=0.05, active=not useAdaptive2, group="Tilson 2")
factorAdp2   = input.float(1.0, "ER Sensitivity",        minval=0.1, maxval=5.0, step=0.1, active=useAdaptive2, group="Tilson 2", tooltip="1 = linear. Acima de 1 filtra mais a lateralização; abaixo de 1 responde mais cedo.")
vScale2      = input.float(1.0, "Escala Vertical",   minval=-100.0, maxval=100.0, step=0.05, group="Tilson 2")
hScale2      = input.float(1.0, "Escala Horizontal", minval=0.01, maxval=100.0, step=0.05, group="Tilson 2")
mainWidth2   = input.int(2, "Line", minval=1, group="Tilson 2", inline="t2Width")
shadowWidth2 = input.int(10, "Shadow", minval=1, group="Tilson 2", inline="t2Width")
t2LineUp     = input.color(#00AAFF, "", group="Tilson 2", inline="t2Line")
t2LineDn     = input.color(#FF6600, "", group="Tilson 2", inline="t2Line")
t2ShadowUp   = input.color(color.new(#00AAFF, 70), "", group="Tilson 2", inline="t2Line")
t2ShadowDn   = input.color(color.new(#FF6600, 70), "", group="Tilson 2", inline="t2Line")
hOffset2     = input.int(0, "Offset Horizontal (barras)", minval=-100, maxval=100, step=5, group="Tilson 2")
vOffset2     = input.int(0, "Offset Vertical Visual", minval=-100, maxval=100, step=1, group="Tilson 2")
vStrength2   = input.float(0.05, "Forca Vertical ATR", minval=0.001, maxval=1.0, step=0.01, group="Tilson 2")
showSigT2    = input.bool(false, "Mostrar Sinais (mudança de cor)", group="Tilson 2")

// ═══════════════════════════════════════════════
//  TILSON 3
// ═══════════════════════════════════════════════

showT3       = input.bool(true, "Mostrar Tilson 3", group="Tilson 3")
lengthT3     = input.int(28, "Period",  minval=1, maxval=200, group="Tilson 3")
smoothT3     = input.int(1,  "Smooth",  minval=0, maxval=50,  group="Tilson 3")
useAdaptive3 = input.bool(false, "Adaptive ER", tooltip="Adapta o vFactor pelo Efficiency Ratio: mais responsivo em tendência e mais suave no ruído.", group="Tilson 3")
factorFix3   = input.float(0.7, "vFactor (fixo)",        minval=0.0, maxval=2.0, step=0.05, active=not useAdaptive3, group="Tilson 3")
factorAdp3   = input.float(1.0, "ER Sensitivity",        minval=0.1, maxval=5.0, step=0.1, active=useAdaptive3, group="Tilson 3", tooltip="1 = linear. Acima de 1 filtra mais a lateralização; abaixo de 1 responde mais cedo.")
vScale3      = input.float(1.0, "Escala Vertical",   minval=-100.0, maxval=100.0, step=0.05, group="Tilson 3")
hScale3      = input.float(1.0, "Escala Horizontal", minval=0.01, maxval=100.0, step=0.05, group="Tilson 3")
mainWidth3   = input.int(2, "Line", minval=1, group="Tilson 3", inline="t3Width")
shadowWidth3 = input.int(10, "Shadow", minval=1, group="Tilson 3", inline="t3Width")
t3LineUp     = input.color(#FFFF00, "", group="Tilson 3", inline="t3Line")
t3LineDn     = input.color(#FF00FF, "", group="Tilson 3", inline="t3Line")
t3ShadowUp   = input.color(color.new(#FFFF00, 70), "", group="Tilson 3", inline="t3Line")
t3ShadowDn   = input.color(color.new(#FF00FF, 70), "", group="Tilson 3", inline="t3Line")
hOffset3     = input.int(0, "Offset Horizontal (barras)", minval=-100, maxval=100, step=5, group="Tilson 3")
vOffset3     = input.int(0, "Offset Vertical Visual", minval=-100, maxval=100, step=1, group="Tilson 3")
vStrength3   = input.float(0.05, "Forca Vertical ATR", minval=0.001, maxval=1.0, step=0.01, group="Tilson 3")
showSigT3    = input.bool(false, "Mostrar Sinais (mudança de cor)", group="Tilson 3")

// ═══════════════════════════════════════════════
//  TIMEFRAME
// ═══════════════════════════════════════════════
useCurrentTF = input.bool(true, "Usar Resolucao do Grafico", group="Timeframe")
customTF     = input.timeframe("D", "Timeframe Customizado", active=not useCurrentTF, group="Timeframe")
confirmCustomTF = input.bool(true, "Usar somente candle confirmado", active=not useCurrentTF, group="Timeframe", tooltip="Evita que a T3 de um timeframe superior mude enquanto a vela desse timeframe ainda esta aberta.")

confirmSignals = input.bool(true, "Confirmar sinais no fechamento da vela", group="Sinais", tooltip="Reduz sinais que aparecem e desaparecem durante a formacao da vela.")

// ═══════════════════════════════════════════════
//  ADAPTATIVO ER (Kaufman Efficiency Ratio)
// ═══════════════════════════════════════════════
erLength = input.int(10, "ER Period", minval=2, maxval=200, group="Adaptive ER")
erVMin   = input.float(0.20, "vFactor minimo", minval=0.0, maxval=1.0, step=0.05, group="Adaptive ER")
erVMax   = input.float(0.90, "vFactor maximo", minval=0.0, maxval=1.0, step=0.05, group="Adaptive ER")

// ═══════════════════════════════════════════════
//  INTELIGENCIA MULTI-TIMEFRAME
// ═══════════════════════════════════════════════
useMTFIntel      = input.bool(false, "Ativar consenso MTF", group="Inteligencia MTF")
mtfTF1           = input.timeframe("15", "Timeframe 1", group="Inteligencia MTF", active=useMTFIntel)
mtfTF2           = input.timeframe("60", "Timeframe 2", group="Inteligencia MTF", active=useMTFIntel)
mtfTF3           = input.timeframe("240", "Timeframe 3", group="Inteligencia MTF", active=useMTFIntel)
mtfTF4           = input.timeframe("1D", "Timeframe 4", group="Inteligencia MTF", active=useMTFIntel)
mtfTF5           = input.timeframe("1W", "Timeframe 5", group="Inteligencia MTF", active=useMTFIntel)
mtfFilterSignals = input.bool(true, "Filtrar sinais pelo consenso", group="Inteligencia MTF", active=useMTFIntel)
mtfThreshold     = input.float(0.60, "Consenso minimo", minval=0.0, maxval=1.0, step=0.05, group="Inteligencia MTF", active=useMTFIntel and mtfFilterSignals)
showMTFTable     = input.bool(true, "Mostrar painel MTF", group="Inteligencia MTF", active=useMTFIntel)

efficiencyRatio(source, len) =>
    direction = math.abs(source - source[len])
    noise = ta.sma(math.abs(source - source[1]), len) * len
    noise > 0 ? math.min(1.0, direction / noise) : 0.0

// ═══════════════════════════════════════════════
//  FUNCAO T3 (Tilson 1998 — GD approach)
//  GD(n,v) = EMA(n)*(1+v) - EMA(EMA(n))*v
//  T3 = GD(GD(GD(n)))
// ═══════════════════════════════════════════════
t3calc(source, len, smooth, vf, hScaleIn, vScaleIn) =>
    sc = math.max(1, math.round(len * hScaleIn))
    e  = math.max(0.0, math.min(2.0, vf))
    c1 = -math.pow(e, 3)
    c2 =  3 * math.pow(e, 2) + 3 * math.pow(e, 3)
    c3 = -6 * math.pow(e, 2) - 3 * e - 3 * math.pow(e, 3)
    c4 =  1 + 3 * e + math.pow(e, 3) + 3 * math.pow(e, 2)
    e1 = ta.ema(source, sc)
    e2 = ta.ema(e1, sc)
    e3 = ta.ema(e2, sc)
    e4 = ta.ema(e3, sc)
    e5 = ta.ema(e4, sc)
    e6 = ta.ema(e5, sc)
    base = c1*e6 + c2*e5 + c3*e4 + c4*e3
    smoothed = smooth > 0 ? ta.sma(base, smooth) : base
    mean = ta.sma(smoothed, 10)
    (smoothed - mean) * vScaleIn + mean

vFloor   = math.min(erVMin, erVMax)
vCeiling = math.max(erVMin, erVMax)

t3Configured(source, len, smooth, useAdaptive, fixedFactor, sensitivity, hScaleIn, vScaleIn) =>
    er = efficiencyRatio(source, erLength)
    vf = useAdaptive ? vFloor + (vCeiling - vFloor) * math.pow(er, sensitivity) : fixedFactor
    t3calc(source, len, smooth, vf, hScaleIn, vScaleIn)

// O voto MTF usa exatamente a configuracao da Tilson 2 e a ultima vela confirmada.
t3Direction(source) =>
    value = t3Configured(source, lengthT2, smoothT2, useAdaptive2, factorFix2, factorAdp2, hScale2, vScale2)
    value > value[1] ? 1.0 : value < value[1] ? -1.0 : 0.0

// Timeframes iguais ou abaixo da resolução-base são ignorados, pois o timeframe
// base já participa da votação. Para os inferiores seria necessário
// request.security_lower_tf(), cujo resultado é um array de intrabarras.
mtfDirection(tf, baseSeconds) =>
    timeframe.in_seconds(tf) > baseSeconds ? request.security(syminfo.tickerid, tf, t3Direction(src_input)[1], lookahead=barmerge.lookahead_on) : na

// ═══════════════════════════════════════════════
//  FONTE DE DADOS
// ═══════════════════════════════════════════════
res = useCurrentTF ? timeframe.period : customTF
baseSeconds = timeframe.in_seconds(res)
chartSeconds = timeframe.in_seconds()
customIsLower = not useCurrentTF and baseSeconds < chartSeconds

if customIsLower
    runtime.error("O timeframe customizado deve ser igual ou superior ao timeframe do grafico para manter a precisao.")

// A T3 inteira e calculada dentro do timeframe solicitado. Isso evita processar
// varias vezes no grafico os mesmos valores repetidos de uma vela superior.
[t1Live, t2Live, t3Live, erLive, atrLive] = request.security(syminfo.tickerid, res, [t3Configured(src_input, lengthT1, smoothT1, useAdaptive1, factorFix1, factorAdp1, hScale1, vScale1), t3Configured(src_input, lengthT2, smoothT2, useAdaptive2, factorFix2, factorAdp2, hScale2, vScale2), t3Configured(src_input, lengthT3, smoothT3, useAdaptive3, factorFix3, factorAdp3, hScale3, vScale3), efficiencyRatio(src_input, erLength), ta.atr(14)], lookahead=barmerge.lookahead_off)
[t1Confirmed, t2Confirmed, t3Confirmed, erConfirmed, atrConfirmed] = request.security(syminfo.tickerid, res, [t3Configured(src_input, lengthT1, smoothT1, useAdaptive1, factorFix1, factorAdp1, hScale1, vScale1)[1], t3Configured(src_input, lengthT2, smoothT2, useAdaptive2, factorFix2, factorAdp2, hScale2, vScale2)[1], t3Configured(src_input, lengthT3, smoothT3, useAdaptive3, factorFix3, factorAdp3, hScale3, vScale3)[1], efficiencyRatio(src_input, erLength)[1], ta.atr(14)[1]], lookahead=barmerge.lookahead_on)

useConfirmedCustom = not useCurrentTF and confirmCustomTF and baseSeconds > chartSeconds
t1Raw = useConfirmedCustom ? t1Confirmed : t1Live
t2Raw = useConfirmedCustom ? t2Confirmed : t2Live
t3Raw = useConfirmedCustom ? t3Confirmed : t3Live
erValue = useConfirmedCustom ? erConfirmed : erLive
atrVal = useConfirmedCustom ? atrConfirmed : atrLive

// Cada voto usa a ultima barra confirmada do seu proprio timeframe.
mtfBase = useMTFIntel ? request.security(syminfo.tickerid, res, t3Direction(src_input)[1], lookahead=barmerge.lookahead_on) : na
mtfState1 = useMTFIntel ? mtfDirection(mtfTF1, baseSeconds) : na
mtfState2 = useMTFIntel ? mtfDirection(mtfTF2, baseSeconds) : na
mtfState3 = useMTFIntel ? mtfDirection(mtfTF3, baseSeconds) : na
mtfState4 = useMTFIntel ? mtfDirection(mtfTF4, baseSeconds) : na
mtfState5 = useMTFIntel ? mtfDirection(mtfTF5, baseSeconds) : na

mtfCount = (not na(mtfBase) ? 1.0 : 0.0) + (not na(mtfState1) ? 1.0 : 0.0) + (not na(mtfState2) ? 1.0 : 0.0) + (not na(mtfState3) ? 1.0 : 0.0) + (not na(mtfState4) ? 1.0 : 0.0) + (not na(mtfState5) ? 1.0 : 0.0)
mtfSum = nz(mtfBase) + nz(mtfState1) + nz(mtfState2) + nz(mtfState3) + nz(mtfState4) + nz(mtfState5)
mtfReady = mtfCount >= 2
mtfScore = mtfReady ? mtfSum / mtfCount : 0.0

// Disponível na Janela de Dados para facilitar calibração e comparação.
plot(erValue, title="Efficiency Ratio", display=display.data_window, editable=false)
plot(useMTFIntel ? mtfScore * 100.0 : na, title="Consenso MTF (%)", display=display.data_window, editable=false)

// Deslocamento vertical visual por ATR.
// Pine nao permite mover plots por pixel real; esta simulacao fica proporcional ao ativo/timeframe.
vMoveStep1 = atrVal * vStrength1
vMoveStep2 = atrVal * vStrength2
vMoveStep3 = atrVal * vStrength3

// ═══════════════════════════════════════════════
//  CALCULOS DOS 3 T3
// ═══════════════════════════════════════════════
t1 = t1Raw + (vOffset1 * vMoveStep1)
t2 = t2Raw + (vOffset2 * vMoveStep2)
t3 = t3Raw + (vOffset3 * vMoveStep3)

// ═══════════════════════════════════════════════
//  CORES
// ═══════════════════════════════════════════════
// Trechos planos preservam a direcao, inclusive em timeframes superiores.
var bool isUp1 = false
var bool isUp2 = false
var bool isUp3 = false
isUp1 := t1 > t1[1] ? true : t1 < t1[1] ? false : isUp1
isUp2 := t2 > t2[1] ? true : t2 < t2[1] ? false : isUp2
isUp3 := t3 > t3[1] ? true : t3 < t3[1] ? false : isUp3

// Nivel 5 equivale ao antigo nivel 1; niveis menores estreitam a transicao.
// Sem suavizacao adicional para nao atrasar a cor em relacao a inclinacao.
useGradient = gradientLevel > 0
gradientWindow = 100
gradientSmooth = 1
gradientRange = 0.06 * math.max(1, gradientLevel)

// Normalizacao simetrica da inclinacao: subida e descida usam a mesma escala.
// Cada chamada mantem o historico da sua propria media.
gradientStrength(float value) =>
    slope = nz(value - value[1])
    scale = ta.highest(math.abs(slope), gradientWindow)
    normalized = scale > 0 ? slope / scale : 0.0
    ta.ema(normalized, gradientSmooth)

strength1 = gradientStrength(t1)
strength2 = gradientStrength(t2)
strength3 = gradientStrength(t3)

isDn1 = t1 < t1[1]
isDn2 = t2 < t2[1]
isDn3 = t3 < t3[1]

// ═══════════════════════════════════════════════
//  PLOTAGEM
// ═══════════════════════════════════════════════
plot(showT1 ? t1 : na, title="Tilson 1 (Valor)", display=display.status_line + display.data_window, editable=false)
plot(showT2 ? t2 : na, title="Tilson 2 (Valor)", display=display.status_line + display.data_window, editable=false)
plot(showT3 ? t3 : na, title="Tilson 3 (Valor)", display=display.status_line + display.data_window, editable=false)

t1LineColor = useGradient ? color.from_gradient(strength1, -gradientRange, gradientRange, t1LineDn, t1LineUp) : (isUp1 ? t1LineUp : t1LineDn)
t1ShadowColor = useGradient ? color.from_gradient(strength1, -gradientRange, gradientRange, t1ShadowDn, t1ShadowUp) : (isUp1 ? t1ShadowUp : t1ShadowDn)

plot(showT1 ? t1 : na, title="Tilson 1 Sombra", color=t1ShadowColor, linewidth=shadowWidth1, offset=hOffset1, display=display.pane, editable=false)
plot(showT1 ? t1 : na, title="Tilson 1", color=t1LineColor, linewidth=mainWidth1, offset=hOffset1, display=display.pane, editable=false)

t2LineColor = useGradient ? color.from_gradient(strength2, -gradientRange, gradientRange, t2LineDn, t2LineUp) : (isUp2 ? t2LineUp : t2LineDn)
t2ShadowColor = useGradient ? color.from_gradient(strength2, -gradientRange, gradientRange, t2ShadowDn, t2ShadowUp) : (isUp2 ? t2ShadowUp : t2ShadowDn)

plot(showT2 ? t2 : na, title="Tilson 2 Sombra", color=t2ShadowColor, linewidth=shadowWidth2, offset=hOffset2, display=display.pane, editable=false)
plot(showT2 ? t2 : na, title="Tilson 2", color=t2LineColor, linewidth=mainWidth2, offset=hOffset2, display=display.pane, editable=false)

t3LineColor = useGradient ? color.from_gradient(strength3, -gradientRange, gradientRange, t3LineDn, t3LineUp) : (isUp3 ? t3LineUp : t3LineDn)
t3ShadowColor = useGradient ? color.from_gradient(strength3, -gradientRange, gradientRange, t3ShadowDn, t3ShadowUp) : (isUp3 ? t3ShadowUp : t3ShadowDn)

plot(showT3 ? t3 : na, title="Tilson 3 Sombra", color=t3ShadowColor, linewidth=shadowWidth3, offset=hOffset3, display=display.pane, editable=false)
plot(showT3 ? t3 : na, title="Tilson 3", color=t3LineColor, linewidth=mainWidth3, offset=hOffset3, display=display.pane, editable=false)

// ═══════════════════════════════════════════════
//  SINAIS — mudança de cor
// ═══════════════════════════════════════════════
mtfBullAllowed = not useMTFIntel or not mtfFilterSignals or not mtfReady or mtfScore >= mtfThreshold
mtfBearAllowed = not useMTFIntel or not mtfFilterSignals or not mtfReady or mtfScore <= -mtfThreshold
signalBarReady = not confirmSignals or barstate.isconfirmed

sigUp1 = signalBarReady and ta.crossover(t1, t1[1]) and mtfBullAllowed
sigDn1 = signalBarReady and ta.crossunder(t1, t1[1]) and mtfBearAllowed
sigUp2 = signalBarReady and ta.crossover(t2, t2[1]) and mtfBullAllowed
sigDn2 = signalBarReady and ta.crossunder(t2, t2[1]) and mtfBearAllowed
sigUp3 = signalBarReady and ta.crossover(t3, t3[1]) and mtfBullAllowed
sigDn3 = signalBarReady and ta.crossunder(t3, t3[1]) and mtfBearAllowed

plotchar(showT1 and showSigT1 and sigUp1, title="Sinal Alta (Tilson 1)", char="▲", location=location.belowbar, color=t1LineUp, size=size.small, offset=hOffset1, display=display.pane)
plotchar(showT1 and showSigT1 and sigDn1, title="Sinal Baixa (Tilson 1)", char="▼", location=location.abovebar, color=t1LineDn, size=size.small, offset=hOffset1, display=display.pane)
plotchar(showT2 and showSigT2 and sigUp2, title="Sinal Alta (Tilson 2)", char="▲", location=location.belowbar, color=t2LineUp, size=size.small, offset=hOffset2, display=display.pane)
plotchar(showT2 and showSigT2 and sigDn2, title="Sinal Baixa (Tilson 2)", char="▼", location=location.abovebar, color=t2LineDn, size=size.small, offset=hOffset2, display=display.pane)
plotchar(showT3 and showSigT3 and sigUp3, title="Sinal Alta (Tilson 3)", char="▲", location=location.belowbar, color=t3LineUp, size=size.small, offset=hOffset3, display=display.pane)
plotchar(showT3 and showSigT3 and sigDn3, title="Sinal Baixa (Tilson 3)", char="▼", location=location.abovebar, color=t3LineDn, size=size.small, offset=hOffset3, display=display.pane)

// ═══════════════════════════════════════════════
//  SINAIS — cruzamento 1 x 2 / 2 x 3
// ═══════════════════════════════════════════════
crossUp1   = signalBarReady and ta.crossover(t1, t2) and mtfBullAllowed
crossDn1   = signalBarReady and ta.crossunder(t1, t2) and mtfBearAllowed
crossUp2   = signalBarReady and ta.crossover(t2, t3) and mtfBullAllowed
crossDn2   = signalBarReady and ta.crossunder(t2, t3) and mtfBearAllowed

// ═══════════════════════════════════════════════
//  PAINEL DE CONSENSO MTF
// ═══════════════════════════════════════════════
mtfStateText(state) =>
    na(state) ? "IGNORADO" : state > 0 ? "ALTA" : state < 0 ? "BAIXA" : "NEUTRO"

mtfStateColor(state) =>
    na(state) ? color.new(color.gray, 70) : state > 0 ? color.new(color.green, 35) : state < 0 ? color.new(color.red, 35) : color.new(color.yellow, 45)

var table mtfPanel = table.new(position.top_right, 2, 8, frame_color=color.new(color.gray, 40), frame_width=1)

if barstate.islast
    if useMTFIntel and showMTFTable
        table.cell(mtfPanel, 0, 0, "T3 MTF", text_color=color.white, bgcolor=color.new(color.blue, 35))
        table.cell(mtfPanel, 1, 0, "DIRECAO", text_color=color.white, bgcolor=color.new(color.blue, 35))
        table.cell(mtfPanel, 0, 1, res, text_color=color.white)
        table.cell(mtfPanel, 1, 1, mtfStateText(mtfBase), text_color=color.white, bgcolor=mtfStateColor(mtfBase))
        table.cell(mtfPanel, 0, 2, mtfTF1, text_color=color.white)
        table.cell(mtfPanel, 1, 2, mtfStateText(mtfState1), text_color=color.white, bgcolor=mtfStateColor(mtfState1))
        table.cell(mtfPanel, 0, 3, mtfTF2, text_color=color.white)
        table.cell(mtfPanel, 1, 3, mtfStateText(mtfState2), text_color=color.white, bgcolor=mtfStateColor(mtfState2))
        table.cell(mtfPanel, 0, 4, mtfTF3, text_color=color.white)
        table.cell(mtfPanel, 1, 4, mtfStateText(mtfState3), text_color=color.white, bgcolor=mtfStateColor(mtfState3))
        table.cell(mtfPanel, 0, 5, mtfTF4, text_color=color.white)
        table.cell(mtfPanel, 1, 5, mtfStateText(mtfState4), text_color=color.white, bgcolor=mtfStateColor(mtfState4))
        table.cell(mtfPanel, 0, 6, mtfTF5, text_color=color.white)
        table.cell(mtfPanel, 1, 6, mtfStateText(mtfState5), text_color=color.white, bgcolor=mtfStateColor(mtfState5))
        scoreColor = not mtfReady ? color.new(color.gray, 55) : mtfScore >= mtfThreshold ? color.new(color.green, 20) : mtfScore <= -mtfThreshold ? color.new(color.red, 20) : color.new(color.orange, 25)
        scoreText = mtfReady ? str.tostring(mtfScore * 100.0, "#.0") + "%" : "SEM DADOS"
        table.cell(mtfPanel, 0, 7, "CONSENSO", text_color=color.white, bgcolor=scoreColor)
        table.cell(mtfPanel, 1, 7, scoreText, text_color=color.white, bgcolor=scoreColor)
    else
        table.clear(mtfPanel, 0, 0, 1, 7)

// ═══════════════════════════════════════════════
//  ALERTAS
// ═══════════════════════════════════════════════
t1Buy = sigUp1
t1Sell = sigDn1
t1Color = t1Buy or t1Sell

t2Buy = sigUp2
t2Sell = sigDn2
t2Color = t2Buy or t2Sell

t3Buy = sigUp3
t3Sell = sigDn3
t3Color = t3Buy or t3Sell

alertcondition(t1Buy, title="Tilson 1 BUY", message="Tilson 1 BUY | {{ticker}} | {{interval}} | Fechamento: {{close}}")
alertcondition(t1Sell, title="Tilson 1 SELL", message="Tilson 1 SELL | {{ticker}} | {{interval}} | Fechamento: {{close}}")
alertcondition(t1Color, title="Tilson 1 Color ALARM", message="Tilson 1 mudou de cor | {{ticker}} | {{interval}} | Fechamento: {{close}}")

alertcondition(t2Buy, title="Tilson 2 BUY", message="Tilson 2 BUY | {{ticker}} | {{interval}} | Fechamento: {{close}}")
alertcondition(t2Sell, title="Tilson 2 SELL", message="Tilson 2 SELL | {{ticker}} | {{interval}} | Fechamento: {{close}}")
alertcondition(t2Color, title="Tilson 2 Color ALARM", message="Tilson 2 mudou de cor | {{ticker}} | {{interval}} | Fechamento: {{close}}")

alertcondition(t3Buy, title="Tilson 3 BUY", message="Tilson 3 BUY | {{ticker}} | {{interval}} | Fechamento: {{close}}")
alertcondition(t3Sell, title="Tilson 3 SELL", message="Tilson 3 SELL | {{ticker}} | {{interval}} | Fechamento: {{close}}")
alertcondition(t3Color, title="Tilson 3 Color ALARM", message="Tilson 3 mudou de cor | {{ticker}} | {{interval}} | Fechamento: {{close}}")

alertcondition(crossUp1, "Tilson 1 cruza Tilson 2 — Alta",  "Tilson 1 cruzou Tilson 2 para CIMA | {{ticker}} | {{interval}} | Fechamento: {{close}}")
alertcondition(crossDn1, "Tilson 1 cruza Tilson 2 — Baixa", "Tilson 1 cruzou Tilson 2 para BAIXO | {{ticker}} | {{interval}} | Fechamento: {{close}}")
alertcondition(crossUp2, "Tilson 2 cruza Tilson 3 — Alta",  "Tilson 2 cruzou Tilson 3 para CIMA | {{ticker}} | {{interval}} | Fechamento: {{close}}")
alertcondition(crossDn2, "Tilson 2 cruza Tilson 3 — Baixa", "Tilson 2 cruzou Tilson 3 para BAIXO | {{ticker}} | {{interval}} | Fechamento: {{close}}")

mtfConsensusUpRaw = ta.crossover(mtfScore, mtfThreshold)
mtfConsensusDnRaw = ta.crossunder(mtfScore, -mtfThreshold)
mtfConsensusUp = signalBarReady and useMTFIntel and mtfReady and mtfConsensusUpRaw
mtfConsensusDn = signalBarReady and useMTFIntel and mtfReady and mtfConsensusDnRaw
alertcondition(mtfConsensusUp, "Consenso MTF — Alta", "Tilson MTF confirmou ALTA | {{ticker}} | {{interval}} | Fechamento: {{close}}")
alertcondition(mtfConsensusDn, "Consenso MTF — Baixa", "Tilson MTF confirmou BAIXA | {{ticker}} | {{interval}} | Fechamento: {{close}}")

// ═══════════════════════════════════════════════
//  HALO RECORRENTE NA PONTA DAS MEDIAS
// ═══════════════════════════════════════════════
showRadar = input.bool(true, "Mostrar halo na ponta das linhas", group="Halo")
radarMode = input.string("Por atualizacao", "Ritmo do pulso", options=["Por atualizacao", "Por tempo"], group="Halo", tooltip="Por atualizacao avanca uma etapa a cada tick, evitando repetir a mesma fase com ticks espacados. Ambos os modos precisam de dados ao vivo.")
radarTicks = input.int(24, "Atualizacoes por ciclo", minval=4, maxval=200, group="Halo", active=radarMode == "Por atualizacao")
radarSeconds = input.float(2.0, "Duracao do ciclo (segundos)", minval=0.3, maxval=10.0, step=0.1, group="Halo", tooltip="O pulso avanca quando chegam atualizacoes do mercado. Sem novos ticks, a animacao fica parada.")
radarDotSize = input.int(7, "Tamanho do ponto", minval=1, maxval=30, group="Halo", tooltip="Tamanho tipografico do simbolo; nao representa pixels exatos.")
radarExpansion = input.int(20, "Expansao dos aneis", minval=4, maxval=60, group="Halo")
radarTransparency = input.int(35, "Transparencia inicial dos aneis", minval=0, maxval=100, group="Halo", tooltip="0 = opaco no inicio do pulso; 100 = invisivel. Independe da transparencia da linha.")
radarPointTransparency = input.int(0, "Transparencia do ponto", minval=0, maxval=100, group="Halo")
radarPointFixed = input.bool(false, "Sobrescrever cor do ponto", group="Halo", inline="radarPoint")
radarPointColor = input.color(color.white, "Cor fixa", group="Halo", inline="radarPoint", active=radarPointFixed)
radarRingFixed = input.bool(false, "Sobrescrever cor dos aneis", group="Halo", inline="radarRing")
radarRingColor = input.color(color.aqua, "Cor fixa", group="Halo", inline="radarRing", active=radarRingFixed)

// varip preserva a fase entre ticks e entre barras; nao e reiniciada pelo rollback.
varip float radarTickPhase = 0.0
if barstate.isrealtime
    radarTickPhase := (radarTickPhase + 1.0 / radarTicks) % 1.0

// Cada chamada conserva apenas tres labels, reutilizados em todas as barras.
// Os simbolos vazados aproximam um radar sem cobrir o interior com uma cor solida.
// timenow controla somente o desenho: nao interfere nos calculos ou sinais.
drawRadar(float value, color lineColor, bool visible, int horizontalOffset) =>
    var label ring1 = label.new(na, na, "○", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, textalign=text.align_center)
    var label ring2 = label.new(na, na, "○", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, textalign=text.align_center)
    var label dot = label.new(na, na, "●", xloc=xloc.bar_index, yloc=yloc.price, style=label.style_none, textalign=text.align_center)
    if barstate.islast
        active = showRadar and visible and not na(value) and not na(lineColor)
        x = bar_index + horizontalOffset
        y = active ? value : na
        cycleMs = radarSeconds * 1000.0
        phase1 = radarMode == "Por atualizacao" ? radarTickPhase : (timenow % cycleMs) / cycleMs
        phase2 = (phase1 + 0.5) % 1.0
        // Transparencias explicitas substituem a transparencia da linha/cor.
        pointRgb = radarPointFixed ? radarPointColor : lineColor
        ringRgb = radarRingFixed ? radarRingColor : lineColor
        alpha1 = radarTransparency + (100.0 - radarTransparency) * phase1
        alpha2 = radarTransparency + (100.0 - radarTransparency) * phase2
        label.set_xy(ring1, x, y)
        label.set_xy(ring2, x, y)
        label.set_xy(dot, x, y)
        label.set_size(ring1, radarDotSize + int(math.round(radarExpansion * phase1)))
        label.set_size(ring2, radarDotSize + int(math.round(radarExpansion * phase2)))
        label.set_size(dot, radarDotSize)
        label.set_textcolor(ring1, color.new(ringRgb, alpha1))
        label.set_textcolor(ring2, color.new(ringRgb, alpha2))
        label.set_textcolor(dot, color.new(pointRgb, radarPointTransparency))
    true

drawRadar(t1, t1LineColor, showT1, hOffset1)
drawRadar(t2, t2LineColor, showT2, hOffset2)
drawRadar(t3, t3LineColor, showT3, hOffset3)


// PONTOS FIXOS NAS VIRADAS — independentes do radar na ponta.
// Uma marca por troca de sinal da inclinacao usada pelo degrade.
// O ponto fica no inicio do segmento com a nova direcao (barra anterior).
// E desenhado somente apos a deteccao/confirmacao na barra atual.
showTurns = input.bool(true, "Mostrar ponto com halo nas viradas", group="Viradas")
showTurnPoint = input.bool(true, "Mostrar ponto", group="Viradas")
showTurnHalo = input.bool(true, "Mostrar halo", group="Viradas")
turnPointWidth = input.int(2, "Tamanho do ponto", minval=1, maxval=30, step=1, group="Viradas", tooltip="Aceita 1, 5, 10 etc. Escala relativa de circulos do TradingView; nao e diametro exato em pixels.")
turnHaloWidth = input.int(5, "Tamanho do halo", minval=1, maxval=50, step=1, group="Viradas", tooltip="Use um valor maior que o ponto para ver o halo ao redor. Escala relativa, nao pixels exatos.")
turnPointTransparency = input.int(0, "Transparencia do ponto", minval=0, maxval=100, group="Viradas", tooltip="0 = opaco; 100 = invisivel. Substitui a transparencia da cor selecionada e da linha.")
turnTransparency = input.int(50, "Transparencia do halo", minval=0, maxval=100, group="Viradas", tooltip="0 = opaco; 100 = invisivel. Independente do ponto e da linha; a linha continua visivel por baixo.")
turnPointFixed = input.bool(false, "Sobrescrever cor do ponto", group="Viradas", inline="pointColor")
turnPointColor = input.color(color.white, "Cor fixa", group="Viradas", inline="pointColor", active=turnPointFixed)
turnHaloFixed = input.bool(false, "Sobrescrever cor do halo", group="Viradas", inline="haloColor")
turnHaloColor = input.color(color.aqua, "Cor fixa", group="Viradas", inline="haloColor", active=turnHaloFixed)
// As cores fornecem o RGB; os controles numericos acima definem a transparencia.

var int turnSide1 = 0
if signalBarReady and not na(t1[2])
    if useGradient
        if strength1 > 0
            turnSide1 := 1
        else if strength1 < 0
            turnSide1 := -1
    else
        turnSide1 := isUp1 ? 1 : -1
turn1 = signalBarReady and nz(turnSide1[1]) != 0 and turnSide1 != turnSide1[1]
turnValue1 = showTurns and showT1 and turn1 ? t1[1] : na
turnColor1 = turnSide1 > 0 ? t1LineUp : t1LineDn
turnHaloColor1 = color.new(turnHaloFixed ? turnHaloColor : turnColor1, turnTransparency)
turnPointDrawColor1 = color.new(turnPointFixed ? turnPointColor : turnColor1, turnPointTransparency)
plot(showTurnHalo ? turnValue1 : na, title="Tilson 1 Virada Halo", style=plot.style_circles, color=turnHaloColor1, linewidth=turnHaloWidth, offset=hOffset1 - 1, display=display.pane, editable=false)
plot(showTurnPoint ? turnValue1 : na, title="Tilson 1 Virada Ponto", style=plot.style_circles, color=turnPointDrawColor1, linewidth=turnPointWidth, offset=hOffset1 - 1, display=display.pane, editable=false)

var int turnSide2 = 0
if signalBarReady and not na(t2[2])
    if useGradient
        if strength2 > 0
            turnSide2 := 1
        else if strength2 < 0
            turnSide2 := -1
    else
        turnSide2 := isUp2 ? 1 : -1
turn2 = signalBarReady and nz(turnSide2[1]) != 0 and turnSide2 != turnSide2[1]
turnValue2 = showTurns and showT2 and turn2 ? t2[1] : na
turnColor2 = turnSide2 > 0 ? t2LineUp : t2LineDn
turnHaloColor2 = color.new(turnHaloFixed ? turnHaloColor : turnColor2, turnTransparency)
turnPointDrawColor2 = color.new(turnPointFixed ? turnPointColor : turnColor2, turnPointTransparency)
plot(showTurnHalo ? turnValue2 : na, title="Tilson 2 Virada Halo", style=plot.style_circles, color=turnHaloColor2, linewidth=turnHaloWidth, offset=hOffset2 - 1, display=display.pane, editable=false)
plot(showTurnPoint ? turnValue2 : na, title="Tilson 2 Virada Ponto", style=plot.style_circles, color=turnPointDrawColor2, linewidth=turnPointWidth, offset=hOffset2 - 1, display=display.pane, editable=false)

var int turnSide3 = 0
if signalBarReady and not na(t3[2])
    if useGradient
        if strength3 > 0
            turnSide3 := 1
        else if strength3 < 0
            turnSide3 := -1
    else
        turnSide3 := isUp3 ? 1 : -1
turn3 = signalBarReady and nz(turnSide3[1]) != 0 and turnSide3 != turnSide3[1]
turnValue3 = showTurns and showT3 and turn3 ? t3[1] : na
turnColor3 = turnSide3 > 0 ? t3LineUp : t3LineDn
turnHaloColor3 = color.new(turnHaloFixed ? turnHaloColor : turnColor3, turnTransparency)
turnPointDrawColor3 = color.new(turnPointFixed ? turnPointColor : turnColor3, turnPointTransparency)
plot(showTurnHalo ? turnValue3 : na, title="Tilson 3 Virada Halo", style=plot.style_circles, color=turnHaloColor3, linewidth=turnHaloWidth, offset=hOffset3 - 1, display=display.pane, editable=false)
plot(showTurnPoint ? turnValue3 : na, title="Tilson 3 Virada Ponto", style=plot.style_circles, color=turnPointDrawColor3, linewidth=turnPointWidth, offset=hOffset3 - 1, display=display.pane, editable=false)
